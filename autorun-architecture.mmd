%% Regenerate SVG: npx @mermaid-js/mermaid-cli mmdc -i autorun-architecture.mmd -o autorun-architecture.svg
%%{init: {'theme': 'base', 'themeVariables': { 'fontSize': '18px', 'fontFamily': 'Arial', 'maxTextWidth': 300, 'subgraphBkg': '#f7fafc', 'lineColor': '#4a5568', 'edgeLabelBackground': '#ffffff'}}}%%
flowchart TD
    %% ========================================
    %%  STYLING
    %% ========================================
    classDef stepBox fill:#1a365d,stroke:#2c5282,stroke-width:4px,color:#fff,font-size:20px,font-weight:bold;
    classDef choiceBox fill:#2b6cb0,stroke:#2c5282,stroke-width:3px,color:#fff,font-size:16px,font-weight:bold;
    classDef aiBox fill:#276749,stroke:#22543d,stroke-width:4px,color:#fff,font-size:18px,font-weight:bold;
    classDef guardBox fill:#c53030,stroke:#742a2a,stroke-width:3px,color:#fff,font-size:14px,font-weight:bold;
    classDef safeBox fill:#ed8936,stroke:#c05621,stroke-width:3px,color:#fff,font-size:16px,font-weight:bold;
    classDef doneBox fill:#48bb78,stroke:#276749,stroke-width:4px,color:#fff,font-size:18px,font-weight:bold;
    classDef settingBox fill:#718096,stroke:#4a5568,stroke-width:2px,color:#fff,font-size:15px,font-weight:bold;
    classDef settingsPanel fill:#e2e8f0,stroke:#a0aec0,stroke-width:2px,color:#2d3748,font-size:15px,font-weight:bold;

    %% ========================================
    %%  STEP 1: INSTALL
    %% ========================================
    INSTALL["💿 STEP 1<br/><br/>INSTALL AUTORUN"]:::stepBox
    INSTALL_CMD["uv tool install autorun-ai<br/>autorun --install<br/>──────────<br/>adds hooks, commands and skills<br/>to each AI coding agent it finds"]:::choiceBox

    %% ========================================
    %%  STEP 2: CHOOSE HOW AI WORKS
    %% ========================================
    subgraph WORKFLOW_OPTIONS[" "]
        direction TB
        PROVIDE["📋 STEP 2<br/><br/>PROVIDE TASK INSTRUCTIONS"]:::stepBox
        subgraph WORKFLOW_CMDS[" "]
            direction LR
            W1["<b>Run task directly</b><br/>──────────<br/>/ar:go &lt;instructions&gt;"]:::choiceBox

            W2["<b>Multi-step projects (plan skills)</b><br/>──────────<br/><b>Create new plan</b><br/>/ar:plannew &lt;instructions&gt;<br/>──────────<br/><b>Refine plan</b><br/>/ar:planrefine &lt;instructions&gt;<br/>──────────<br/><b>Update plan</b><br/>/ar:planupdate &lt;instructions&gt;<br/>──────────<br/><b>Execute plan</b><br/>/ar:planprocess &lt;instructions&gt;"]:::choiceBox

            W1 --- W2
        end
        PROVIDE --> WORKFLOW_CMDS
    end

    %% ========================================
    %%  STEP 3: AI WORKS, WITH THE SETTINGS INSIDE IT
    %% ========================================
    subgraph AI_STEP["🤖 STEP 3: AI WORKS"]
        direction TB
        AI_ENGINE["🔄 Works autonomously and keeps going until its tasks are done<br/><br/>1️⃣ IMPLEMENT<br/>2️⃣ EVALUATE<br/>3️⃣ VERIFY<br/><br/>(You can step away!)"]:::aiBox

        subgraph SETTINGS["⚙️ ADJUST ANYTIME"]
            direction LR
            B1["<b>Commands that delete or discard work are blocked</b><br/>──────────<br/><b>Allow one run</b><br/>/ar:ok &lt;pattern&gt;<br/>──────────<br/><b>Allow 3 runs, or for 1 hour</b><br/>/ar:ok &lt;pattern&gt; 3<br/>/ar:ok &lt;pattern&gt; 1h<br/>──────────<br/><b>Block another command</b><br/>/ar:no #quot;&lt;pattern&gt;#quot; reason<br/>──────────<br/><b>In ALL sessions</b><br/>/ar:ok --global, /ar:no --global<br/>──────────<br/><b>Clear session blocks and allows</b><br/>/ar:clear"]:::settingBox

            T1["<b>Tracked tasks</b><br/>──────────<br/><b>Show tasks and reminders</b><br/>/ar:tasks<br/>──────────<br/><b>Let the agent stop for now</b><br/>/ar:task pause"]:::settingBox

            B1 ~~~ T1 ~~~ F1
            F1["<b>New files</b><br/>──────────<br/><b>Allow all file creation</b><br/>/ar:file allow<br/>──────────<br/><b>Require a justification</b><br/>/ar:file justify<br/>──────────<br/><b>Edit existing files only</b><br/>/ar:file existing-only<br/>──────────<br/><b>Show current settings</b><br/>/ar:status"]:::settingBox
        end

        AI_ENGINE ~~~ SETTINGS
    end

    %% ========================================
    %%  COMPLETE
    %% ========================================
    COMPLETE["✅ TASK COMPLETE!"]:::doneBox

    %% ========================================
    %%  FLOW
    %% ========================================
    INSTALL --> INSTALL_CMD
    INSTALL_CMD --> WORKFLOW_OPTIONS
    WORKFLOW_OPTIONS --> AI_STEP
    AI_STEP -->|"done"| COMPLETE

    style AI_STEP fill:#e6f4ea,stroke:#22543d,stroke-width:4px,color:#22543d

    %% Make all connector lines thicker
    linkStyle default stroke-width:6px
